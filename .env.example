# Banco de dados (Neon PostgreSQL)
DATABASE_URL="postgresql://usuario:senha@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Autenticação (Auth.js v5 + Google OAuth)
# Gere um segredo com: npx auth secret  (ou openssl rand -base64 32)
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Controle de acesso Multi-Conta
# - Lista de e-mails Google autorizados (separados por vírgula).
# - O PRIMEIRO e-mail da lista é tratado como conta primária (herda preferências
#   antigas sem prefixo e o CLICKUP_API_TOKEN padrão abaixo, se não houver token próprio).
# - Use "*" para permitir qualquer conta Google verificada.
ALLOWED_EMAILS="principal@gmail.com,segunda@empresa.com"
# Compatibilidade legada (opcional se ALLOWED_EMAILS estiver definido):
# ALLOWED_EMAIL="principal@gmail.com"

# ClickUp (opcional como fallback para a conta primária)
# Outras contas podem configurar seu próprio token em: Configurações -> ClickUp & Atalhos
CLICKUP_API_TOKEN=""

# Classificação automática de e-mails e assistente (Anthropic Claude)
ANTHROPIC_API_KEY=""
# Modelo opcional (padrão: claude-haiku-4-5-20251001)
# ANTHROPIC_MODEL="claude-haiku-4-5-20251001"

# Criptografia de tokens salvos no banco (opcional; usa AUTH_SECRET como fallback)
# PREFS_ENCRYPTION_KEY=""

# Listas do ClickUp (opcional; formato id:Nome separados por vírgula)
# CLICKUP_LISTS="1000480000007959:Sustentação CFTV · Sprint 01,901321112382:Projeto G.A. Plus Ultra"
